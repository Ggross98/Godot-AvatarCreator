<Project>
  <PropertyGroup>
    <!-- Must be set before Microsoft.Common.props. Godot.NET.Sdk otherwise puts
         restore assets under .godot/, which Cursor's C# language server does not load. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)obj\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
